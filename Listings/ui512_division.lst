	    0000000000000000
	   ]

 00000100  00000008 [		quotient		QWORD			8 dup (?)							; working copy of quotient
	    0000000000000000
	   ]
 00000140  00000008 [		normdivisor		QWORD			8 dup (?)							; working copy of normalized divisor
	    0000000000000000
	   ]

 00000180  0000000000000000	nDiv1			QWORD			?									; first qword of normalized divisor
 00000188  0000000000000000	nDiv2			QWORD			?									; second qword of normalized divisor

